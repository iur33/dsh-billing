{
  "name": "dsh-peak-billing",
  "version": "0.1.0",
  "description": "DSH billing plugin: live session cost at DeepSeek's official peak rates, with optional cross-machine aggregation over SSH. · DSH 峰时价计费插件：会话实时费用，可选 SSH 多机汇总。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pricing": "./lib/pricing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/verify.mjs && node test/ledger.mjs && node test/render.mjs"
  },
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "billing",
    "cost",
    "peak",
    "usage"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
